# App
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/nexusai

# Redis
REDIS_URL=redis://localhost:6379

# JWT
# JWT_ACCESS_SECRET and JWT_REFRESH_SECRET should be a random string of at least 64 characters
JWT_ACCESS_SECRET=your_super_secret_access_token_key_at_least_64_characters_long_for_security
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_at_least_64_characters_long_for_security
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email
EMAIL_FROM=noreply@nexusai.dev
RESEND_API_KEY=re_xxxx

# AI Providers
GOOGLE_AI_API_KEY=your_google_ai_api_key
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Active models
ENABLED_MODELS=gemini-1.5-pro,gemini-1.5-flash

# Credit Config (credits per 1K tokens)
CREDIT_RATE_GEMINI_PRO=5
CREDIT_RATE_GEMINI_FLASH=2

# Welcome Bonus
WELCOME_BONUS_CREDITS=100

# Swagger
SWAGGER_ENABLED=false

# Rate Limits
RATE_LIMIT_AUTH=10
RATE_LIMIT_AI_FREE=30
RATE_LIMIT_AI_PRO=120
